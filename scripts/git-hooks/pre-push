#!/bin/bash
# Pre-push git hook: ensure submodule commits are pushed before the parent push.

# When git invokes pre-push from inside a worktree, it exports GIT_DIR /
# GIT_WORK_TREE pointing at the *parent* repo's worktree gitdir. Those vars
# override path-based repo discovery (including `git -C <submodule>`), causing
# downstream submodule diff checks and parent-repo git operations to target the
# wrong repository. Clear them so ordinary cwd-/-C-based discovery works.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_PREFIX

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the repository root
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
PUSH_SUBMODULES="$REPO_ROOT/scripts/push-submodules.sh"

# --- 1. Ensure submodules are pushed (block push if they have uncommitted changes) ---
echo -e "${GREEN}=== Submodule push check ===${NC}"
if [ -f "$PUSH_SUBMODULES" ]; then
    if ! bash "$PUSH_SUBMODULES"; then
        echo -e "${RED}Push aborted: fix submodule state above, then push again.${NC}"
        exit 1
    fi
else
    echo -e "${YELLOW}push-submodules.sh not found, continuing${NC}"
fi

# Never commit here: a commit made during pre-push is not part of the push
# already in flight, so it stays local and leaves the branch diverged from its
# remote. Regenerated .cursor/commands and floating submodule refs are left in
# the working tree for the author to commit deliberately.
echo -e "${GREEN}=== Pre-push checks complete ===${NC}"
exit 0
