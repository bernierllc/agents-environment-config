{
  "schema": "loadout/v1",
  "item_type": "plugin",
  "name": "my-plugin",
  "version": "1.0.0",
  "description": "Example per-tool plugin: one scripted install and two instructions-only installs.",
  "source": "https://github.com/example/my-plugin",
  "homepage": "https://github.com/example/my-plugin",
  "author": { "name": "Example Author", "url": "https://github.com/example" },
  "license": "MIT",
  "supports": ["claude", "cursor", "gemini"],
  "usage": "Type /my-plugin in your agent.",
  "install_type": "per-tool",
  "install": {
    "tools": {
      "claude": { "run": ["npx", "my-plugin", "install", "--agent", "claude"] },
      "cursor": { "steps": "Copy my-plugin's rules into .cursor/rules/ per https://github.com/example/my-plugin#cursor" },
      "gemini": { "steps": "Add my-plugin to your Gemini extensions per https://github.com/example/my-plugin#gemini" }
    }
  },
  "uninstall": {
    "tools": {
      "claude": { "run": ["npx", "my-plugin", "uninstall", "--agent", "claude"] },
      "cursor": { "steps": "Delete the my-plugin files from .cursor/rules/." },
      "gemini": { "steps": "Remove my-plugin from your Gemini extensions." }
    }
  }
}
