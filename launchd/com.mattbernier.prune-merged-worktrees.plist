<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mattbernier.prune-merged-worktrees</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mattbernier/projects/agents-environment-config/scripts/prune-merged-worktrees.sh</string>
    </array>
    <!-- Daily at 4:00 AM local; runs on wake if the Mac was asleep.
         Install: cp launchd/com.mattbernier.prune-merged-worktrees.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.mattbernier.prune-merged-worktrees.plist -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/Users/mattbernier/Library/pnpm:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/mattbernier/Library/Logs/prune-merged-worktrees.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mattbernier/Library/Logs/prune-merged-worktrees.log</string>
</dict>
</plist>
