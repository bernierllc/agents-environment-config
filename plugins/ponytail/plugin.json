{
  "schema": "loadout/v1",
  "item_type": "plugin",
  "name": "ponytail",
  "version": "4.10.0",
  "description": "Lazy-senior-dev review/build discipline for AI coding agents: YAGNI, stdlib first, the simplest solution that works.",
  "source": "https://github.com/DietrichGebert/ponytail",
  "homepage": "https://github.com/DietrichGebert/ponytail",
  "author": { "name": "Dietrich Gebert", "url": "https://github.com/DietrichGebert" },
  "license": "MIT",
  "supports": ["claude"],
  "usage": "Type /ponytail in Claude Code to toggle modes; /ponytail-help lists the rest.",
  "install_type": "marketplace",
  "install": {
    "marketplace": "DietrichGebert/ponytail",
    "plugin": "ponytail@ponytail"
  },
  "uninstall": {
    "tools": {
      "claude": { "run": ["claude", "plugin", "uninstall", "ponytail@ponytail"] }
    }
  }
}
